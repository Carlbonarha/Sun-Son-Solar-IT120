# Ignore local environment configuration (CRITICAL: keeps passwords safe)
.env
*.env.*
!/env

# Ignore XAMPP / OS specific files
.DS_Store
Thumbs.db
error_log

# Ignore CodeIgniter 4 system logs and writable data
/writable/bootstrapping
/writable/cache/*
!/writable/cache/index.html
/writable/debugbar/*
/writable/logs/*
!/writable/logs/index.html
/writable/session/*
!/writable/session/index.html
/writable/uploads/*
!/writable/uploads/index.html

# Ignore dependencies if you installed them via Composer locally
/vendor/
